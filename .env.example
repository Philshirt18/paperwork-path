# Copy to .env.local and fill in. Never commit .env.local.
# Without a key the app works fully; only "Ask in your own words" is switched off.
ANTHROPIC_API_KEY=

# Public demo protection (optional, these are the defaults).
# Model calls per IP per window. One question is usually 2 to 4 calls.
AGENT_CALLS_PER_IP=40
AGENT_WINDOW_MINUTES=60
# Estimated spend per day (UTC) after which the assistant pauses until midnight.
# Also set a spend limit on the API key in the Anthropic Console: that is the real hard stop.
AGENT_DAILY_BUDGET_USD=2

# Shown when the assistant is off or out of budget.
NEXT_PUBLIC_DEMO_VIDEO_URL=
